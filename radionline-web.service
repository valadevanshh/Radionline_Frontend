[Unit]
Description=RadioNet PACS Next.js
After=network.target radionline-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/radionline/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
